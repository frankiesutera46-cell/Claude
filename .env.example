# ── General ───────────────────────────────────────────
POLL_INTERVAL_MINUTES=15
LOG_LEVEL=INFO

# ── Trading Mode ─────────────────────────────────────
# "dry_run" = log trades without placing them (default, safe)
# "live"    = actually place orders on Polymarket
TRADING_MODE=dry_run

# ── Polymarket CLOB API credentials ──────────────────
# Get these from https://polymarket.com — required for live trading
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# ── Risk Limits ──────────────────────────────────────
# Max % of bankroll per single trade (default: 5%)
MAX_POSITION_PCT=0.05
# Max % of bankroll in open positions (default: 30%)
MAX_TOTAL_EXPOSURE_PCT=0.30
# Kelly fraction — 0.25 = quarter-Kelly, conservative (default)
KELLY_FRACTION=0.25
# Minimum edge to place a trade (default: 5%)
MIN_EDGE=0.05
# Minimum model confidence (default: 55%)
MIN_CONFIDENCE=0.55
# Stop trading after this % daily loss (default: 10%)
DAILY_LOSS_LIMIT_PCT=0.10
# Max trades per day (default: 10)
MAX_TRADES_PER_DAY=10
# Min order size in USD (default: $1)
MIN_ORDER_SIZE=1.0
# Max order size in USD (default: $100)
MAX_ORDER_SIZE=100.0

# ── Data Sources ─────────────────────────────────────
POLYMARKET_API_URL=https://gamma-api.polymarket.com
COINGECKO_API_URL=https://api.coingecko.com/api/v3
